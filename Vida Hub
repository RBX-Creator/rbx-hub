-- 10. MAIN RENDERING LOOP (CORRECTED MOTION-DETECTION FOR FLY AND WALK)
local lastLightningTime = 0

RunService.RenderStepped:Connect(function()
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local hrp = char.HumanoidRootPart
    local hum = char.Humanoid

    local currentFlySpeed = getFlySpeed()
    local currentWalkSpeed = getWalkSpeed()
    local moveVector = ControlModule:GetMoveVector()
    
    -- KORREKTUR: Erkennt Bewegung auch bei Fly (über Tasteninput) oder normalem Lauf (über Velocity)
    local isActivelyMoving = (moveVector.Magnitude > 0) or (hrp.Velocity.Magnitude > 2)
    
    -- Blitze zünden NUR bei aktiver Bewegung UND wenn der jeweilige Regler auf Maximum (125+) steht
    if isActivelyMoving and ((flyOn and currentFlySpeed >= 125) or (speedOn and currentWalkSpeed >= 125)) then
        local now = tick()
        if now - lastLightningTime > 0.02 then -- Höhere Frequenz für noch mehr Dichte
            lastLightningTime = now
            
            -- Spawnt 4 dichte Ausbrüche gleichzeitig
            for i = 1, 4 do
                local sideOffset = (i % 2 == 0 and -2.5 or 2.5) + math.random(-1, 1)
                local startLightning = hrp.Position + hrp.CFrame.RightVector * sideOffset + Vector3.new(0, math.random(-3, 3), 0)
                local endLightning = startLightning - hrp.CFrame.LookVector * (8 + math.random(0, 12))
                
                generateLightningBolt(startLightning, endLightning, 8) -- 8 Segmente für feine, realistische Knicke
            end
        end
    end

    -- NOCLIP
    if flyOn or stickyTpOn or (speedOn and getWalkSpeed() > 50) then
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end
    
    -- STICKY TP
    if stickyTpOn and tpTargetPlayer and tpTargetPlayer.Character and tpTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = tpTargetPlayer.Character.HumanoidRootPart.CFrame
        hrp.Velocity = Vector3.new(0, 0, 0)
    elseif stickyTpOn then
        stickyTpOn = false tpTargetPlayer = nil tpPlayerBtn.Text = "TP PLAYER: OFF" tpPlayerS.Color = Color3.fromRGB(120, 0, 0)
    end

    -- WATER WALKER
    if hrp.Position.Y < 5 then waterPart.CFrame = CFrame.new(hrp.Position.X, 0, hrp.Position.Z) else waterPart.CFrame = CFrame.new(0, -500, 0) end

    -- AIMBOT
    if aimOn then
        local target = nil
        local dist = 150
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= char then
                if v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                    local d = (hrp.Position - v.HumanoidRootPart.Position).Magnitude
                    if d < dist then target = v.HumanoidRootPart dist = d end
                end
            end
        end
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end

    -- AUTO KILL HUNTING
    if tracking and currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") and currentTarget:FindFirstChild("Humanoid") then
        hrp.CFrame = currentTarget.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        if currentTarget.Humanoid.Health <= 0 then tracking = false killBtn.Text = "AUTO KILL: OFF" end
    end

    -- GHOST CONTROL
    if ghostOn then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromEulerAnglesYXZ(rotY, rotX, 0)
        local mv = ControlModule:GetMoveVector()
        Camera.CFrame = Camera.CFrame + (Camera.CFrame.LookVector * -mv.Z + Camera.CFrame.RightVector * mv.X) * 2
    -- FLY CONTROL
    elseif flyOn then
        local mv = ControlModule:GetMoveVector()
        hrp.Velocity = Vector3.new(0,0,0)
        local lookAtCFrame = CFrame.new(hrp.Position) * Camera.CFrame.Rotation
        
        if currentFlySpeed > 10 then
            hrp.CFrame = lookAtCFrame + (Camera.CFrame.LookVector * -mv.Z + Camera.CFrame.RightVector * mv.X) * 10
            if mv.Magnitude > 0 then
                local rawDirection = (Camera.CFrame.LookVector * -mv.Z + Camera.CFrame.RightVector * mv.X)
                if rawDirection.Magnitude > 0 then
                    local warpFactor = (currentFlySpeed - 10) * 0.36
                    hrp.CFrame = hrp.CFrame + (rawDirection.Unit * warpFactor)
                end
            end
        else
            hrp.CFrame = lookAtCFrame + (Camera.CFrame.LookVector * -mv.Z + Camera.CFrame.RightVector * mv.X) * currentFlySpeed
        end
    end
    
    -- SPEED WARP
    if speedOn then 
        local targetSpeed = getWalkSpeed()
        if targetSpeed > 60 then
            local moveVector = ControlModule:GetMoveVector()
            if moveVector.Magnitude > 0 then
                local rawDirection = (Camera.CFrame.LookVector * -moveVector.Z + Camera.CFrame.RightVector * moveVector.X)
                local flatDirection = Vector3.new(rawDirection.X, 0, rawDirection.Z)
                if flatDirection.Magnitude > 0 then
                    flatDirection = flatDirection.Unit
                    local warpFactor = (targetSpeed - 60) * 0.36
                    hrp.CFrame = hrp.CFrame + (flatDirection * warpFactor)
                end
            end
            hum.WalkSpeed = 60
        else hum.WalkSpeed = targetSpeed end
    else hum.WalkSpeed = 16 end
end)

-- DRAGGING
local dragging, dragStart, startPos
topBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true dragStart = input.Position startPos = mainContainer.Position end end)
UserInputService.InputChanged:Connect(function(input) 
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainContainer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    elseif ghostOn and input.UserInputType == Enum.UserInputType.Touch and input.Position.X > (Camera.ViewportSize.X / 2) then
        rotX = rotX - input.Delta.X * 0.005 rotY = math.clamp(rotY - input.Delta.Y * 0.005, -1.4, 1.4)
    end
end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
