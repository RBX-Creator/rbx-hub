local function drawLightningSegment(startPos, endPos)
    local p = Instance.new("Part")
    p.Name = "DemonLightning"
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(130, 0, 0) -- Extrem dunkles, reines Rot
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = false
    
    local dist = (endPos - startPos).Magnitude
    p.Size = Vector3.new(0.04, 0.04, dist) -- Haardünne Segmente für maximalen Realismus
    p.CFrame = CFrame.new(startPos:Lerp(endPos, 0.5), endPos)
    p.Parent = lightningFolder
    
    task.spawn(function()
        for i = 1, 4 do
            p.Transparency = i * 0.25
            task.wait(0.02)
        end
        p:Destroy()
    end)
end

local function generateLightningBolt(startPoint, endPoint, steps)
    local lastPos = startPoint
    for i = 1, steps do
        local t = i / steps
        local targetPos = startPoint:Lerp(endPoint, t)
        
        if i < steps then
            -- Sehr organische Offsets für feine Zacken
            local offset = Vector3.new(
                math.random(-8, 8) * 0.1,
                math.random(-8, 8) * 0.1,
                math.random(-8, 8) * 0.1
            )
            targetPos = targetPos + offset
        end
        
        drawLightningSegment(lastPos, targetPos)
        lastPos = targetPos
    end
end

